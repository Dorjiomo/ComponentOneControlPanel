<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-desktop</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <ApplicationTitle>ComponentOneControlPanel</ApplicationTitle>
        <ApplicationId>com.dtb.ComponentOneControlPanel</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationPublisher>dorji</ApplicationPublisher>
        <Description>ComponentOneControlPanel powered by Uno Platform.</Description>

        <UnoFeatures>
            SimpleTheme;
            Hosting;
            Toolkit;
            Logging;
            LoggingSerilog;
            MVUX;
            Configuration;
            HttpKiota;
            Serialization;
            Localization;
            Navigation;
            ThemeService;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="Assets\Data\products.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Update="Assets\Icons\c1-logo.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="C:\Users\dorji\Desktop\Installer\c1-installer\ComponentOneControlPanel\UpdatedDesign\ComponentOneControlPanel\PackageDownloaderCore\PackageDownloaderCore.csproj" />
    </ItemGroup>
</Project>