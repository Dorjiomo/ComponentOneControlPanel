<Page
    x:Class="ComponentOneControlPanel.Presentation.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:models="using:ComponentOneControlPanel.Models"
    Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="TopTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CategoryPillStyle" TargetType="Button">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="72"/>

        </Style>

    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">

            <Grid
                MaxWidth="1500"
                Margin="28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->

                <StackPanel>

                    <!-- HEADER -->

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="14">

                        <Image
                            Source="ms-appx:///Assets/Icons/c1-logo.png"
                            Width="44"
                            Height="44"/>

                        <TextBlock
                            Text="ComponentOne Control Panel"
                            VerticalAlignment="Center"
                            FontSize="30"
                            FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- TABS -->

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="28"
                        Margin="0,28,0,18">

                        <Button
                            x:Name="InstalledTabButton"
                            Content="Installed"
                            Click="InstalledTab_Click"
                            Style="{StaticResource TopTabButtonStyle}"/>

                        <Button
                            x:Name="AvailableTabButton"
                            Content="Available"
                            Click="AvailableTab_Click"
                            Style="{StaticResource TopTabButtonStyle}"/>

                        <Button
                            Content="Activities"
                            Style="{StaticResource TopTabButtonStyle}"
                            Opacity="0.6"/>

                        <Button
                            Content="License"
                            Style="{StaticResource TopTabButtonStyle}"
                            Opacity="0.6"/>

                        <Button
                            Content="Apps and Tools"
                            Style="{StaticResource TopTabButtonStyle}"
                            Opacity="0.6"/>
                    </StackPanel>

                    <Border
                        Height="1"
                        Background="#D8D8D8"
                        Margin="0,0,0,18"/>

                    <!-- FILTERS -->

                    <ItemsControl
                        x:Name="CategoryRepeater"
                        Margin="0,0,0,22">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="sys:String">

                                <Button
                                    Style="{StaticResource CategoryPillStyle}"
                                    Loaded="CategoryButton_Loaded"
                                    PointerEntered="CategoryButton_PointerEntered"
                                    PointerExited="CategoryButton_PointerExited"
                                    Margin="0,0,10,10"
                                    MinWidth="70"
                                    Height="34"
                                    Padding="16,0"
                                    CornerRadius="18"
                                    BorderThickness="1"
                                    Click="CategoryButton_Click">

                                    <TextBlock
                                        Text="{x:Bind}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>

                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- EMPTY -->

                    <TextBlock
                        x:Name="EmptyTextBlock"
                        Visibility="Collapsed"
                        Text="No available products match this filter."
                        Margin="6,10,0,0"
                        FontSize="15"
                        Foreground="#777777"/>

                    <!-- PRODUCTS -->

                    <ItemsControl x:Name="ProductsRepeater">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:ProductCardInfo">

                                <Border
                                    Background="White"
                                    CornerRadius="3"
                                    Margin="0,0,0,14"
                                    Padding="22"
                                    BorderBrush="#ECECEC"
                                    BorderThickness="1">

                                    <StackPanel>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- BADGE -->

                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{Binding BadgeColor}"
                                                CornerRadius="4"
                                                VerticalAlignment="Top">

                                                <TextBlock
                                                    Text="{Binding Badge}"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- INFO -->

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="6,0,0,0">

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Text="{Binding Framework}"
                                                    FontSize="13"
                                                    Foreground="#666666"
                                                    Margin="0,2,0,0"/>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="0,8,0,0">

                                                    <TextBlock
                                                        Text="ⓘ"
                                                        Foreground="#0078D4"
                                                        FontSize="12"/>

                                                    <TextBlock
                                                        Text="Latest version"
                                                        FontWeight="SemiBold"
                                                        FontSize="13"/>     
                                                </StackPanel>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    Margin="0,6,0,0">

                                                    <TextBlock
                                                        Text="{Binding Version}"
                                                        FontSize="13"
                                                        Foreground="#666666"/>

                                                    <TextBlock
                                                        Text="View details"
                                                        FontSize="13"
                                                        Foreground="#0078D4"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ACTIONS -->

                                            <StackPanel
                                                Grid.Column="2"
                                                Spacing="10"
                                                Width="140">

                                                <Button
                                                    Content="✎  Modify"
                                                    IsEnabled="{Binding ModifyEnabled}"
                                                    Height="38"
                                                    Width="140"/>
                                                

                                                <Button
                                                    Content="{Binding ActionButtonText}"
                                                    IsEnabled="{Binding InstallEnabled}"
                                                    Height="38"
                                                    Width="140"
                                                    BorderBrush="#0078D4"
                                                    Foreground="#0078D4"
                                                    Background="White"
                                                    Click="Install_Click"/>

                                                <Button
                                                    Content="Uninstall"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Height="38"
                                                    Width="140"
                                                    Click="Uninstall_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- INLINE PROGRESS -->

                                        <Grid
                                        Margin="0,20,0,0"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}">       

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding ProgressText}"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="#444444"/>      

                                            <ProgressBar
                                                Grid.Column="1"
                                                Height="8"
                                                Margin="18,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding InstallProgress}"
                                                VerticalAlignment="Center"
                                                Foreground="#0A6ED1"
                                                Background="#E6E6E6"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding ProgressPercentageText}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                FontSize="15"
                                                Foreground="#555555"/>

                                            <Button
                                                Grid.Column="3"
                                                Content="✕"
                                                Width="34"
                                                Height="34"
                                                Margin="12,0,0,0"
                                                CornerRadius="17"
                                                Background="Transparent"
                                                BorderBrush="#D0D0D0"
                                                Foreground="#666666"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- RIGHT -->

                <Border
                    Grid.Column="1"
                    Margin="28,72,0,0"
                    Padding="22"
                    Background="White"
                    BorderBrush="#E2E2E2"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="ComponentOne News"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,24,0,0"
                            Text="Today I will migrate a WinForms grid to .NET 10"
                            Foreground="#0078D4"
                            FontSize="14"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="A short walkthrough on moving legacy WinForms data grids onto the latest runtime."
                            TextWrapping="Wrap"
                            FontSize="13"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Wednesday, August 26, 2026"
                            FontSize="12"
                            Foreground="#888888"/>

                        <TextBlock
                            Margin="0,40,0,0"
                            Text="Control Panel version 4.2.10.130"
                            FontSize="12"
                            Foreground="#777777"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- STATUS -->

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1,1,0,0">

            <Grid Margin="14,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="InstallProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Height="16"
                    VerticalAlignment="Center"/>

                <TextBlock
                    x:Name="StatusTextBlock"
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"/>
            </Grid>
        </Border>

        <!-- SNACKBAR -->

        <Border
            x:Name="SnackbarBorder"
            Visibility="Collapsed"
            Background="White"
            BorderBrush="#DADADA"
            BorderThickness="1"
            CornerRadius="4"
            Padding="18,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,70">

            <TextBlock
                x:Name="SnackbarTextBlock"
                FontSize="14"/>
        </Border>
    </Grid>
</Page>
